<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.dictate</string>
    <!-- Must live OUTSIDE ~/Documents, ~/Desktop, ~/Downloads: those are TCC-protected,
         and a launchd-spawned process hangs in dyld trying to open a binary there
         (see CLAUDE.md gotcha #13). Install the built binary to ~/.local/bin.
         NOTE: launchd does NOT expand `~`, so this path must be absolute. Replace
         YOUR_USERNAME with your macOS user — the install step in the README/CLAUDE.md
         does it for you (`sed "s|/Users/YOUR_USERNAME|$HOME|" …`). -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USERNAME/.local/bin/dictate</string>
        <string>daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- DICTATE_IDLE_UNLOAD_SEC: free the resident ~573 MB Metal model after this many seconds
         idle (gotcha #7). 0/unset = stay resident. The first take after an unload pays a
         ~600 ms-1 s reload.
         DICTATE_WATCHDOG_SEC: restart the daemon after this long with a stalled main run loop.
         Lowered from the built-in default of 30 s after the 2026-08-17 wedge, where the UI
         (hotkey, banner, menubar ⟳ — all main-thread) was dead for the full timeout before the
         watchdog fired. The mic-start section, which is where that wedge landed, has its own and
         much tighter deadline (DICTATE_TAKESTART_SEC, default 8 s). -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>DICTATE_IDLE_UNLOAD_SEC</key>
        <string>300</string>
        <key>DICTATE_WATCHDOG_SEC</key>
        <string>15</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/dictate.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/dictate.log</string>
</dict>
</plist>
